# ============================================================
# Aplicació SAP B1 — Motor de Preparació de Comandes de Venda
# ============================================================
# Aquesta variant llegeix de la base de dades de SAP Business One
# (SQL Server) en lloc de Kais. Corre en paral·lel amb l'app Kais.

# --- Conexió a SAP B1 (SQL Server) ---
# Format del servidor: '<host>\<instancia>', '<host>' (instancia per defecte)
# o '<host>,<port>'.
SAP_SQL_SERVER=<host>\<instancia>
SAP_SQL_DATABASE=DB_FARINERA_TEST
SAP_SQL_USER=sa
SAP_SQL_PASSWORD=<contrasenya_segura>

# --- Path a l'aplicació Kais canònica (mòduls compartits: models, regles, mailer) ---
# Si no es defineix, s'agafa `..\preparacioComandesVenda` (mateix disc, pare).
# KAIS_APP_PATH=P:\preparacioComandesVenda

# --- Port ---
# Kais escolta al 5001, SAP escolta al 5002 per defecte.
PORT=5002

# --- Seguretat administració ---
ADMIN_KEY=canvia_aquesta_clau

# --- Correu autorització (Power Automate o Microsoft Graph, opcional) ---
POWER_AUTOMATE_WEBHOOK_URL=
MAIL_FROM_NAME=Motor Comandes Agrienergia (SAP)
MAIL_FROM_EMAIL=farinera@agrienergia.com
MAIL_TO=destinatari@dominio.com
MAIL_CC=

# --- Calendari (opcional) ---
CALENDARI_URL=
